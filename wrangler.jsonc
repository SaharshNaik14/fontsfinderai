{
	"name": "fonts-finder-ai",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	}
}