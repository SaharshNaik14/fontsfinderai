---
import Layout from '../components/Layout.astro';
---

<Layout noindex title="Something went wrong" description="An unexpected error occurred.">
	<section class="container-page py-24 text-center sm:py-32">
		<p class="gradient-text font-mono text-display-lg font-semibold">500</p>
		<h1 class="mt-3 text-display-lg font-semibold tracking-tight">Something went wrong</h1>
		<p class="mx-auto mt-3 max-w-md text-body-lg text-body">
			We hit an unexpected error on our side. It’s us, not you — try again in a moment.
		</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<a href="/" class="btn btn-primary">Back home</a>
			<a href="/#matcher" class="btn btn-ghost">Identify a font</a>
		</div>
	</section>
</Layout>
